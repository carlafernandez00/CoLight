// Reconstructs an equirectangular (panoramic 2D) environment map from the Quest 3
// passthrough color camera and the Environment Depth API, one texel at a time.
//
// Method: GATHER (output-driven). We iterate over every texel of the output
// panorama, convert it to a world-space direction, then project that direction
// back into the color sensor and the depth camera to fetch color + metric depth.
//
// v1: full-sphere dispatch (no FOV bounding box). Texels whose direction is not
// currently visible to the camera are simply left untouched, so the panorama
// fills in as the user scans the room across many frames (newest sample wins).

#pragma kernel ReconstructEquirect
#pragma kernel ClearDepthAccumulation
#pragma kernel ObtainDepth
#pragma kernel ResolveDepthAndColor

#define PI 3.14159265f
#define SENTINEL 0xFFFFFFFFu  // for uninitialized texels in the depth accumulation buffer

// OUTPUTS (persistent equirect panoramas, never cleared per-frame)
RWTexture2D<float4> _ColorEquirect;           // rgb = linear color, a = 1 where filled
RWTexture2D<float>  _DepthEquirect;           // linear metric depth in meters, 0 = unknown
RWStructuredBuffer<uint> _DepthAccumulation;  // per-texel accumulation of depth samples (uint bits = float bits, sentinel = uninitialized)

int _OutWidth;
int _OutHeight;


// COLOR CAMERA (Meta PassthroughCameraAccess) 
float4x4 _ColorProjectionMatrix;    // color camera projection matrix

float3   _MapCenter;                // world-space camera position at scan time -> maps anchored here (color camera position)
float3   _CameraPos;                // current world-space camera position (from the pose of the passthrough camera)

Texture2D<float4> _ColorTex;
SamplerState      sampler_ColorTex;

// DEPTH (Meta EnvironmentDepthManager globals)
float4x4              _DepthReproj;                      // world -> depth camera clip space (left eye = _EnvironmentDepthReprojectionMatrices[0])
float4x4              _DepthReprojInverse;               // inverse of _DepthReproj: depth camera clip space -> world
float4                _EnvironmentDepthZBufferParams;    // (x = -2fn/(f-n), y = -(f+n)/(f-n), z = 0, w = 0) 

Texture2DArray<float> _EnvironmentDepthTexture;          // NON-linear depth in [0,1]; SampleDepthWorld() unprojects it to world space
SamplerState          sampler_EnvironmentDepthTexture;   // sampler for the depth texture array

static const float DEPTH_MARGIN = 0.03f;   // ignore the noisy border of the depth frame

int   _DepthWidth;      // depth map resolution (for scatter dispatch)
int   _DepthHeight;
float _SplatRadius;     // 0 = only central texel from the splat

float _EpsNoise;        // m, soroll base del depth
// float _EpsFootprint;    // multiplicador de la petjada angular del texel
// float _TexelAngle;      // PI / _OutHeight, en radians
int   _AllowRecede;     // 1 = accepta que una superficie s'allunyi


// HELPERS:
// Convert from texture coordinate to world space direction (matches EnvironmentToSH)
float3 DirFromTexel(uint2 texel)
{
    float u = (texel.x + 0.5f) / (float)_OutWidth;
    float v = (texel.y + 0.5f) / (float)_OutHeight;

    float phi   = (u - 0.5f) * 2.0f * PI;
    float theta = (1.0f - v) * PI;
    float sinT  = sin(theta);

    return float3(sinT * sin(phi), cos(theta), sinT * cos(phi));
}

// Convert from world space direction to texture coordinate (matches EnvironmentToSH)
uint2 TexelFromDir(float3 D)
{
    float phi   = atan2(D.x, D.z);
    float theta = acos(clamp(D.y, -1.0f, 1.0f));

    float u = (phi / (2.0f * PI)) + 0.5f;         // [0,1]
    float v = 1.0f - (theta / PI);                // [0,1]

    uint x = (uint)clamp(u * (float)_OutWidth,  0.0f, (float)_OutWidth  - 1.0f);
    uint y = (uint)clamp(v * (float)_OutHeight, 0.0f, (float)_OutHeight - 1.0f);
    return uint2(x, y);
}

// Convert the depth from eye space to linear metric depth in meters
float LinearDepthMeters(float rawDepth)
{
    float ndcDepth = rawDepth * 2.0f - 1.0f;                                                // convert to NDC [-1,1] = 2 * depth - 1
    float denominator = ndcDepth + _EnvironmentDepthZBufferParams.y;                        // denominator = ndc - (f+n)/(f-n)

    if (abs(denominator) > 1e-6f)
    {
        float depth_in_meters = (1.0f / denominator) * _EnvironmentDepthZBufferParams.x;    // meters = -2fn/(f-n) / denominator
        return depth_in_meters;
    }
    return -1.0f;
}

// Sample the depth texture and convert to world space position (meters). Returns false if the texel is outside the depth camera's FOV
bool SampleDepthWorld(float2 ndcXY, float2 uvPos, out float3 worldPoint)
{
    worldPoint = float3(0.0f, 0.0f, 0.0f);

    // check if it's inside the camera's view (add margin to avoid artifacts at the edges of the depth texture)
    if (uvPos.x < DEPTH_MARGIN || uvPos.x > 1.0f - DEPTH_MARGIN || 
        uvPos.y < DEPTH_MARGIN || uvPos.y > 1.0f - DEPTH_MARGIN) return false;

    
    float raw_depth = _EnvironmentDepthTexture.SampleLevel(
                        sampler_EnvironmentDepthTexture, float3(uvPos, 0.0f), 0).r;
    

    // Get ray direction of the projection 
    float4 q0 = mul(_DepthReprojInverse, float4(ndcXY, 0.25f, 1.0f));        // 0.25 and 0.75 instead of 0, 1 so we don't reach the inf value
    float4 q1 = mul(_DepthReprojInverse, float4(ndcXY, 0.75f, 1.0f));
    float3 dir = normalize(q1.xyz/q1.w - q0.xyz/q0.w);                       // normalize

    // // let's compute the optic axis direction
    // float4 c0 = mul(_DepthReprojInverse, float4(0.0f, 0.0f, 0.25f, 1.0f));   // 0.25 and 0.75 instead of 0, 1 so we don't reach the inf value
    // float4 c1 = mul(_DepthReprojInverse, float4(0.0f, 0.0f, 0.75f, 1.0f));
    // float3 axis = normalize(c1.xyz/c1.w - c0.xyz/c0.w);                      // normalize

    // distance computed with meta linealization
    float d = LinearDepthMeters(raw_depth);
    if (d <= 0.0f) return false;

    // d is the distance perpendicular to the camera plane, i.e., the distance along the optic axis
    // to compute the distance along the ray: d/cos(theta), cos(theta)=dot(dir, axis)
    // float cosT = max(dot(dir, axis), 1e-4f);   
    // worldPoint = _CameraPos + dir * (d / cosT);
    worldPoint = _CameraPos + dir * d;

    return true;
}


// SCANNING MODE: Reconstruct the equirectangular environment map from the color camera and the depth camera
[numthreads(8, 8, 1)]
void ReconstructEquirect(uint3 id : SV_DispatchThreadID)
{

    if ((int)id.x >= _OutWidth || (int)id.y >= _OutHeight) return;

    // 1. Convert from texture coordinate to world space direction 
    float3 D = DirFromTexel(id.xy);

    // 2. COLOR: project direction into the passthrough sensor
    float3 camSpaceCoord = mul(_ColorProjectionMatrix, float4(D, 0.0f)).xyz; 

    // check it's in front of the camera -> only half the sphere is visible
    if (camSpaceCoord.z > 1e-5f)  
    {
        float2 sensor_coord = camSpaceCoord.xy / camSpaceCoord.z;
        
        // check if it's inside the camera's view
        if (sensor_coord.x >= 0.0f && sensor_coord.x <= 1.0f && sensor_coord.y >= 0.0f && sensor_coord.y <= 1.0f)
        {
            float3 color = _ColorTex.SampleLevel(sampler_ColorTex, sensor_coord, 0).rgb;
            _ColorEquirect[id.xy] = float4(color, 1.0f);   // newest sample wins
        }
    }

    // 3. DEPTH: project direction into the depth camera space
    // Slice 0 = left eye, matching the left color camera and reproj matrix [0].
    float4 ndcDepthCoord = mul(_DepthReproj, float4(D, 0.0f));

    // check it's in front of the camera -> only half the sphere is visible
    if (ndcDepthCoord.w > 1e-5f)
    {
        // normalized device coordinates: NDC [-1,1] → UV [0,1]
        float2 ndcXY = ndcDepthCoord.xy / ndcDepthCoord.w;
        float2 uvPos = (ndcXY + 1.0f) * 0.5f; 
        float3 worldPoint;

        if (SampleDepthWorld(ndcXY, uvPos, worldPoint))
        {
            float3 dirFromOrigin = worldPoint - _MapCenter;   // convert to camera space (depth camera is at the origin)
            float depth = length(dirFromOrigin);  
        
            if (depth > 0.0f && depth < 9999.0f)
                _DepthEquirect[id.xy] = depth;   // newest wins
        }
        
    }
}

// UPDATE PANORAMAS, STEP 0: Clear the per-frame depth accumulation buffer
[numthreads(8, 8, 1)]
void ClearDepthAccumulation(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _OutWidth || (int)id.y >= _OutHeight) return;
    _DepthAccumulation[id.y * _OutWidth + id.x] = SENTINEL;   // mark as uninitialized
}

// UPDATE PANORAMAS, STEP 1: Go through depth map to get the new depth values
[numthreads(8, 8, 1)]
void ObtainDepth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_DepthWidth || id.y >= (uint)_DepthHeight) return;

    float2 uv = ((float2)id.xy + 0.5f) / float2(_DepthWidth, _DepthHeight); 
    float2 ndcXY = uv * 2.0f - 1.0f;

    float3 X;
    if (!SampleDepthWorld(ndcXY, uv, X)) return;   // get world point

    float3 D = X - _MapCenter;                     // D = X - Cs
    float  r = length(D);
    if (r <= 0.05f || r >= 9999.0f) return;

    float3 dir = D / r;
    uint2  texel   = TexelFromDir(dir);

    if (_SplatRadius < 0.5f)
    {
        InterlockedMin(_DepthAccumulation[texel.y * _OutWidth + texel.x], asuint(r));
        return;
    }

    // Equirect texels shrink in longitude towards the poles -> we have to widen the texels depending on sin(theta)
    float cosT = dir.y; 
    float sinT2 = saturate(1.0f - cosT * cosT);  // sin2 = 1 - cos2 , saturate to clamp 0, 1 (decimals)
    float sinT = max(sqrt(sinT2), 0.15f);       // limit

    int   ry   = (int)ceil(_SplatRadius);
    int   rx   = (int)ceil(_SplatRadius / sinT);

    // let's go over the pixels around ry, rx
    for (int dy = -ry; dy <= ry; ++dy)
    {
        int y = (int)texel.y + dy;
        if (y < 0 || y >= _OutHeight) continue;
        for (int dx = -rx; dx <= rx; ++dx)
        {
            int x = (int)texel.x + dx;
            // as the horitzontal texgture is ciclic, if the x is lower than 0 or greater than _OutWidth, 
            // we have to paint in the other extrem of the texture
            if      (x < 0)          x += _OutWidth;
            else if (x >= _OutWidth) x -= _OutWidth;

            InterlockedMin(_DepthAccumulation[y * _OutWidth + x], asuint(r));
        }
    }
}


// UPDATE PANORAMAS, STEP 2: Resolve the depth accumulation buffer into the final equirectangular depth panorama and update color where depth is valid
[numthreads(8, 8, 1)]
void ResolveDepthAndColor(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _OutWidth || (int)id.y >= _OutHeight) return;

    uint bits = _DepthAccumulation[id.y * _OutWidth + id.x];
    if (bits == SENTINEL) return;               // Not sampled in this frame

    float rNew = asfloat(bits);                 // |D| = |X - Cs| computed
    float rOld = _DepthEquirect[id.xy];         // Ds stored

    float eps = _EpsNoise;
    bool accept = false;
    if      (rOld == 0.0f)              accept = true;   // first observation
    else if (abs(rNew - rOld) <= eps)   accept = false;  // within sensor noise, keep stored
    else                                accept = true;   // real change, closer or farther

    // TODO: que passa amb les mostres que tenen soroll, hauriem de fer un promig? pensar

    if (!accept) return;

    _DepthEquirect[id.xy] = rNew;

    // Color: project to color camera and sample color
    float3 X = _MapCenter + rNew * DirFromTexel(id.xy);
    float3 c = mul(_ColorProjectionMatrix, float4(X, 1.0f)).xyz;
    if (c.z < 1e-5f) return;

    float2 suv = c.xy / c.z;
    if (suv.x < 0.0f || suv.x > 1.0f || suv.y < 0.0f || suv.y > 1.0f) return;

    _ColorEquirect[id.xy] = float4(
        _ColorTex.SampleLevel(sampler_ColorTex, suv, 0).rgb, 1.0f);
}
