// EnvironmentToSH.compute
// Projects an equirectangular environment map (Skybox/Panoramic) to L2 Spherical Harmonics.
// Outputs 9 coefficients × RGB (27 floats) per probe into _SHCoeffs, with parallax correction
// based on the probe's world-space position relative to a virtual environment sphere of radius R.
//
// For a probe at position P, each env map pixel at direction D corresponds to a point Q = R·D
// on the sphere. The SH basis is evaluated at dirProbe = normalize(Q − P) and the solid angle
// is corrected for the probe's actual distance to Q:
//   dΩ_probe = sin(θ)dθdφ · R² · dot(D, dirProbe) / |Q − P|²
// For P = (0,0,0) this reduces exactly to the original dΩ = sin(θ)dθdφ.

#pragma kernel ProjectEquirectToSH        // Full-scan quadrature (deterministic, every texel)
#pragma kernel ProjectEquirectToSH_IS     // Monte Carlo, luminance importance sampling
#pragma kernel BuildConditionalCDF        // Build per-row conditional CDF (u | v) + row integrals
#pragma kernel BuildMarginalCDF           // Fold row integrals into the marginal CDF (v)

// Debug diffuse-map paint is compiled in ONLY when this keyword is enabled, so
// profiling/normal runs use a kernel with zero debug code (no register/occupancy
// cost). C# toggles it via EnableKeyword/DisableKeyword("DEBUG_DIFFUSE_MAP").
#pragma multi_compile _ DEBUG_DIFFUSE_MAP

// --- Inputs ---
Texture2D<float4>   _EquirectMap;           // Equirectangular environment map (Skybox/Panoramic texture)
SamplerState        sampler_EquirectMap;    // Sampler for _EquirectMap
int                 _TexWidth;              // Width  of _EquirectMap at mip 0
int                 _TexHeight;             // Height of _EquirectMap at mip 0
int                 _MipLevel;              // Mip level to sample (0 = full res, 1 = half, 2 = quarter, ...)
float3              _ProbePosition;         // World-space position of the probe being projected
float               _EnvSphereRadius;       // Radius of the virtual environment sphere (scene scale)
int                 _ProbeIndex;            // Probe slot: coefficients written at [_ProbeIndex*9 + i]
int                 _NumSamples;            // (Importance sampling only) number of Monte Carlo samples per probe

// --- Output ---
// 9 SH coefficients per probe, one float3 (RGB) per coefficient.
// Buffer must have at least (_ProbeIndex + 1) * 9 elements.
RWStructuredBuffer<float3> _SHCoeffs;

// --- Debug map (optional): the SH actually written to the probe 0 ---
// Equirectangular texture painted at the end of ProjectEquirectToSH_IS for the
// ambient probe (index 0). 
RWTexture2D<float4> _DiffuseMap;
int _OutWidth;          // width  of _DiffuseMap (0 = disabled)
int _OutHeight;         // height of _DiffuseMap (0 = disabled)
int _DebugProbeIndex;   // probe for which the debug map is written 

// --- Luminance distribution (importance sampling), built once per env map ---
// PBRT-style piecewise-constant Distribution2D over the (u,v) unit square,
// weighted by luminance(texel) * sin(theta) so bright regions AND the equirect
// distortion are both accounted for. Dimensions are the mip-level dims (W x H).
//   _CondCdf      : per-row normalized CDF along u. Layout: row y occupies
//                   [y*(W+1) .. y*(W+1)+W], with entry 0 == 0 and entry W == 1.
//   _MarginalFunc : per-row integral (unnormalized) = sum over u of func. Length H.
//   _MarginalCdf  : normalized CDF along v. Length H+1, [0]==0, [H]==1.
RWStructuredBuffer<float> _CondCdf;
RWStructuredBuffer<float> _MarginalFunc;
RWStructuredBuffer<float> _MarginalCdf;

// ---------------------------------------------------------------------------
// L2 Spherical Harmonics basis functions Y_i(dir)
// These are the real, normalized SH basis functions up to band 2.
// The constants (0.282095, 0.488603, etc.) are the normalization factors
// derived from the associated Legendre polynomials.
//
// Band 0 (1 function):  constant term
// Band 1 (3 functions): linear terms in x, y, z
// Band 2 (5 functions): quadratic terms
//
// dir = (x, y, z) unit direction vector, Y-up (Unity convention)
// ---------------------------------------------------------------------------

// Band 0
float SH_Y00()           { return 0.282095f; }                                      // 1/(2√π)

// Band 1
float SH_Y1n1(float3 d)  { return 0.488603f * d.y; }                               // √(3/4π) · y
float SH_Y10 (float3 d)  { return 0.488603f * d.z; }                               // √(3/4π) · z
float SH_Y1p1(float3 d)  { return 0.488603f * d.x; }                               // √(3/4π) · x

// Band 2
float SH_Y2n2(float3 d)  { return 1.092548f * d.x * d.y; }                         // √(15/4π) · xy
float SH_Y2n1(float3 d)  { return 1.092548f * d.y * d.z; }                         // √(15/4π) · yz
float SH_Y20 (float3 d)  { return 0.315392f * (3.0f * d.z * d.z - 1.0f); }         // √(5/16π) · (3z²-1)
float SH_Y2p1(float3 d)  { return 1.092548f * d.x * d.z; }                         // √(15/4π) · xz
float SH_Y2p2(float3 d)  { return 0.546274f * (d.x * d.x - d.y * d.y); }          // √(15/16π) · (x²-y²)

#define PI 3.14159265f
#define NUM_THREADS 64

// Rec.709 luminance weights
#define LUMA float3(0.2126f, 0.7152f, 0.0722f)

// ---------------------------------------------------------------------------
// Equirectangular UV → spherical angles (Y-up, Unity Panoramic convention).
// Equirectangular mapping:
//   u ∈ [0,1]  →  phi   (azimuth)  ∈ [0, 2π]
//   v ∈ [0,1]  →  theta (polar)    ∈ [0, π]   (0 = north pole)
//
//   u=0.5 → phi=0 → +Z, matches Unity's Panoramic skybox convention
//   v=0   → theta=π (south pole), v=1 → theta=0 (north pole)
// Used by the debug paint loop; mirrors the inline mapping in the projection kernels.
// ---------------------------------------------------------------------------
float3 DirFromUV(float u, float v)
{
    float phi      = (u - 0.5f) * 2.0f * PI;
    float theta    = (1.0f - v) * PI;
    float sinTheta = sin(theta);
    return float3(sinTheta * sin(phi), cos(theta), sinTheta * cos(phi));
}

// ---------------------------------------------------------------------------
// Hammersley low-discrepancy sequence — used to stratify the Monte Carlo
// samples. Deterministic across frames, so the resulting SH coefficients are
// stable (no temporal flicker) as long as the env map and probes don't move.
// ---------------------------------------------------------------------------
float radicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10f; // / 2^32
}
float2 Hammersley(uint i, uint N) { return float2((float)i / (float)N, radicalInverse_VdC(i)); }

// ---------------------------------------------------------------------------
// Groupshared memory: each thread accumulates into its own slot (no atomics).
// - Threads accumulate independently — no conflict, no atomics
// - Then a halving reduction folds 64 slots into slot [0]
// ---------------------------------------------------------------------------

groupshared float3 gSH[NUM_THREADS][9];   // partial SH per thread 
groupshared float  gWeight[NUM_THREADS];  // partial solid-angle weight per thread 

[numthreads(NUM_THREADS, 1, 1)]
void ProjectEquirectToSH(uint3 groupID : SV_GroupID, uint threadIndex : SV_GroupThreadID)
{
    // Init this thread's groupshared slots with the 9 SH coefficients (RGB each)
    [unroll] for (int k = 0; k < 9; k++) gSH[threadIndex][k] = float3(0, 0, 0);

    // Total solid angle weight for normalization
    gWeight[threadIndex] = 0.0f;
    float R = _EnvSphereRadius;

    // Mip-level loop bounds: each mip halves the resolution (>> is a bitwise right shift)
    int mipW = max(1, _TexWidth  >> _MipLevel);
    int mipH = max(1, _TexHeight >> _MipLevel);

    // Each thread processes a strided subset (stride = NUM_THREADS) of pixels in the mip level
    for (int y = (int)threadIndex; y < mipH; y += NUM_THREADS)
    {
        for (int x = 0; x < mipW; x++)
        {
            // --- Step 1: pixel index → UV in [0,1] ---
            // +0.5 samples the pixel CENTER, not its corner
            float u = (x + 0.5f) / (float)mipW;
            float v = (y + 0.5f) / (float)mipH;

            // --- Step 2: UV → spherical angles ---
            // Equirectangular mapping:
            //   u ∈ [0,1]  →  phi   (azimuth)  ∈ [0, 2π]
            //   v ∈ [0,1]  →  theta (polar)    ∈ [0, π]   (0 = north pole)
            float phi   = (u - 0.5f) * 2.0f * PI;  // u=0.5 → phi=0 → +Z, matches Unity's Panoramic skybox convention
            float theta = (1.0f - v) * PI;         // v=0 → theta=π (south pole), v=1 → theta=0 (north pole)

            // --- Step 3: spherical angles → Cartesian unit direction ---
            // Standard spherical → Cartesian, Y-up (Unity convention)
            float sinTheta = sin(theta);
            float3 dir = float3(
                sinTheta * sin(phi),    // x
                cos(theta),             // y (up)
                sinTheta * cos(phi)     // z
            );

            // --- Step 4: base differential solid angle (equirectangular correction) ---
            // Base solid angle: dΩ = sin(θ) · dθ · dφ
            float dOmega = sinTheta * (PI / mipH) * (2.0f * PI / mipW); // sin(θ) corrects for equirectangular distortion

            // --- Step 5: parallax correction for probe position ---
            // Q is the point on the env sphere in direction `dir`.
            // dirProbe is the true direction from probe P to Q — used for SH basis evaluation.
            // For P=(0,0,0): dirProbe == dir, distSq == R², dOmegaProbe == dOmega exactly.
            float3 Q        = R * dir;
            float3 V        = Q - _ProbePosition;
            float  distSq   = max(dot(V, V), 1e-6f * R * R); // guard against division by zero
            float  dist     = sqrt(distSq);
            float3 dirProbe = V / dist;                      // normalize(Q - P)

            // Solid angle of this patch as seen from probe P:
            //   dΩ_probe = R² · sin(θ)dθdφ · dot(D_outward_normal, dirProbe) / dist²
            // dot(dir, dirProbe) > 0 always for probes strictly inside the sphere.
            float cosAngle    = dot(dir, dirProbe);
            float dOmegaProbe = dOmega * R * R * cosAngle / distSq;

            // --- Step 6: sample environment color at this direction ---
            float3 color = _EquirectMap.SampleLevel(sampler_EquirectMap, float2(u, v), _MipLevel).rgb;

            // --- Step 7: accumulate SH projection ---
            // Use dirProbe (probe-relative direction) for basis functions,
            // dOmegaProbe (parallax-corrected solid angle) as weight.
            gSH[threadIndex][0] += color * SH_Y00()           * dOmegaProbe;
            gSH[threadIndex][1] += color * SH_Y1n1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][2] += color * SH_Y10 (dirProbe)  * dOmegaProbe;
            gSH[threadIndex][3] += color * SH_Y1p1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][4] += color * SH_Y2n2(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][5] += color * SH_Y2n1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][6] += color * SH_Y20 (dirProbe)  * dOmegaProbe;
            gSH[threadIndex][7] += color * SH_Y2p1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][8] += color * SH_Y2p2(dirProbe)  * dOmegaProbe;

            gWeight[threadIndex] += dOmegaProbe;
        }
    }

    // --- Step 8: Halving reduction: merge 64 partial sums into slot [0] ---                                                                        
    // Each step halves the active set; barrier ensures prior writes are visible. 
    GroupMemoryBarrierWithGroupSync();

    [unroll] for (uint stride = NUM_THREADS / 2; stride > 0; stride >>= 1) 
    {
        if (threadIndex < stride)
        {
            [unroll] for (int c = 0; c < 9; c++) gSH[threadIndex][c] += gSH[threadIndex + stride][c];
            gWeight[threadIndex] += gWeight[threadIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Only thread 0 holds the final accumulated result — all others exit
    if (threadIndex != 0) return;

    // --- Step 9: normalize to 4π (total solid angle of a sphere) ---
    // Corrects for numerical drift in the discrete sum.
    float normFactor = (4.0f * PI) / gWeight[0];
    [unroll] for (int j = 0; j < 9; j++)
        gSH[0][j] *= normFactor;

    // --- Step 10: Lambertian (ZH) convolution — radiance → irradiance SH ---
    // Ramamoorthi & Hanrahan 2001 factors, required because Unity's SampleSH9
    // performs a plain polynomial eval with no runtime convolution.
    // gSH[0][0] *= PI;
    // gSH[0][1] *= (2.0f * PI / 3.0f);
    // gSH[0][2] *= (2.0f * PI / 3.0f);
    // gSH[0][3] *= (2.0f * PI / 3.0f);
    // gSH[0][4] *= (PI / 4.0f);
    // gSH[0][5] *= (PI / 4.0f);
    // gSH[0][6] *= (PI / 4.0f);
    // gSH[0][7] *= (PI / 4.0f);
    // gSH[0][8] *= (PI / 4.0f);

    // --- Step 11: write coefficients to output buffer ---
    int base = _ProbeIndex * 9;
    [unroll] for (int i = 0; i < 9; i++) _SHCoeffs[base + i] = gSH[0][i];

    // --- Step 12: Debug ---
    // Debug pass: write the SH just computed for probe _DebugProbeIndex into _DiffuseMap.
    // For each output texel, reconstruct the diffuse color by evaluating the SH basis
    // at the texel's direction. Only thread 0 is alive here, so the loop is NON-strided.
    // Compiled in only when DEBUG_DIFFUSE_MAP is enabled; skipped when _OutWidth/_OutHeight are 0.
#ifdef DEBUG_DIFFUSE_MAP
    if (_ProbeIndex == _DebugProbeIndex)
    {
        int total = _OutWidth * _OutHeight;
        for (int p = 0; p < total; p++)
        {
            int   px = p % _OutWidth;
            int   py = p / _OutWidth;
            float u  = (px + 0.5f) / (float)_OutWidth;
            float v  = (py + 0.5f) / (float)_OutHeight;
            float3 n = DirFromUV(u, v);

            float3 c = gSH[0][0] * SH_Y00()
                     + gSH[0][1] * SH_Y1n1(n)
                     + gSH[0][2] * SH_Y10 (n)
                     + gSH[0][3] * SH_Y1p1(n)
                     + gSH[0][4] * SH_Y2n2(n)
                     + gSH[0][5] * SH_Y2n1(n)
                     + gSH[0][6] * SH_Y20 (n)
                     + gSH[0][7] * SH_Y2p1(n)
                     + gSH[0][8] * SH_Y2p2(n);

            _DiffuseMap[uint2(px, py)] = float4(c, 1.0f);
        }
    }
#endif // DEBUG_DIFFUSE_MAP
}

// ===========================================================================
// Distribution build kernels (importance sampling)
// Run ONCE per environment map, before the per-probe sampling dispatches.
// ===========================================================================

// One thread per row y. Walks that row along u, accumulating importance
// (luminance * sinθ) into an un-normalized running sum, then normalizes it to
// a [0,1] CDF. The row's total importance is stored in _MarginalFunc[y].
[numthreads(NUM_THREADS, 1, 1)]
void BuildConditionalCDF(uint3 id : SV_DispatchThreadID)
{
    int W = max(1, _TexWidth  >> _MipLevel);
    int H = max(1, _TexHeight >> _MipLevel);
    int y = (int)id.x;
    if (y >= H) return;

    float v        = (y + 0.5f) / (float)H;
    float theta    = (1.0f - v) * PI;
    float sinTheta = sin(theta);

    int cbase = y * (W + 1);
    _CondCdf[cbase] = 0.0f;

    float acc = 0.0f;
    for (int x = 0; x < W; x++)
    {
        float  u    = (x + 0.5f) / (float)W;
        float3 c    = _EquirectMap.SampleLevel(sampler_EquirectMap, float2(u, v), _MipLevel).rgb;
        float  func = max(dot(c, LUMA), 0.0f) * sinTheta;   // importance = luminance · sinθ (corrects for equirectangular distortion, so bright regions and poles are both handled)
        acc += func;
        _CondCdf[cbase + x + 1] = acc;                       // un-normalized cumulative
    }

    _MarginalFunc[y] = acc;                                  // row integral (drives marginal)

    // Normalize the row CDF to [0,1]. Empty (black) rows fall back to uniform
    // so the binary search and pdf reconstruction stay well-defined.
    if (acc > 0.0f)
    {
        float inv = 1.0f / acc;
        for (int xn = 1; xn <= W; xn++) _CondCdf[cbase + xn] *= inv;
    }
    else
    {
        for (int xu = 1; xu <= W; xu++) _CondCdf[cbase + xu] = (float)xu / (float)W;
    }
}

// Single thread. Folds the per-row integrals (_MarginalFunc) into the marginal
// CDF over v, then normalizes it. H is small (mip-reduced height), so a serial
// pass is negligible next to the per-probe sampling work.
[numthreads(1, 1, 1)]
void BuildMarginalCDF(uint3 id : SV_DispatchThreadID)
{
    int H = max(1, _TexHeight >> _MipLevel);

    _MarginalCdf[0] = 0.0f;
    float acc = 0.0f;
    for (int y = 0; y < H; y++)
    {
        acc += _MarginalFunc[y];
        _MarginalCdf[y + 1] = acc;
    }

    if (acc > 0.0f)
    {
        float inv = 1.0f / acc;
        for (int yn = 1; yn <= H; yn++) _MarginalCdf[yn] *= inv;
    }
    else
    {
        for (int yu = 1; yu <= H; yu++) _MarginalCdf[yu] = (float)yu / (float)H;
    }
}

// ===========================================================================
// Importance-sampling projection kernel
// One thread group per probe (dispatch (1,1,1) per probe, like the full scan).
// Each thread draws a strided subset of the N Hammersley samples, maps each
// through the luminance distribution to a direction, and accumulates the
// self-normalized Monte Carlo SH estimator.
// ===========================================================================
[numthreads(NUM_THREADS, 1, 1)]
void ProjectEquirectToSH_IS(uint3 groupID : SV_GroupID, uint threadIndex : SV_GroupThreadID)
{
    [unroll] for (int k = 0; k < 9; k++) gSH[threadIndex][k] = float3(0, 0, 0);
    gWeight[threadIndex] = 0.0f;

    float R = _EnvSphereRadius;
    int   W = max(1, _TexWidth  >> _MipLevel);
    int   H = max(1, _TexHeight >> _MipLevel);
    uint  N = (uint)max(1, _NumSamples);

    // Monte Carlo loop: each thread draws a strided subset of the N Hammersley samples
    for (uint s = threadIndex; s < N; s += NUM_THREADS)
    {
        // --- Step 1: Hammersley: gives well-spread 2D points xi. Deterministic -> no flicker across frames. ---
        float2 xi = Hammersley(s, N);

        // --- Step 2: Inverse-CDF sampling of the 2D luminance distribution: PBRT Distribution2D sampling algorithm. ---
        // Sample a row v from the marginal CDF (binary search) 
        int lo = 0, hi = H;
        [loop] while (lo + 1 < hi) { int mid = (lo + hi) >> 1; if (_MarginalCdf[mid] <= xi.x) lo = mid; else hi = mid; }
        int   y      = lo;
        float m0     = _MarginalCdf[y], m1 = _MarginalCdf[y + 1];
        float mSlope = m1 - m0;
        float dv     = (mSlope > 0.0f) ? (xi.x - m0) / mSlope : 0.5f;
        float v      = (y + dv) / (float)H;
        float pdfV   = (float)H * mSlope;                    // marginal density (over [0,1])

        // Sample a column u from that row's conditional CDF 
        int cbase = y * (W + 1);
        int lo2 = 0, hi2 = W;
        [loop] while (lo2 + 1 < hi2) { int mid2 = (lo2 + hi2) >> 1; if (_CondCdf[cbase + mid2] <= xi.y) lo2 = mid2; else hi2 = mid2; }
        int   x      = lo2;
        float c0     = _CondCdf[cbase + x], c1 = _CondCdf[cbase + x + 1];
        float cSlope = c1 - c0;
        float du     = (cSlope > 0.0f) ? (xi.y - c0) / cSlope : 0.5f;
        float u      = (x + du) / (float)W;
        float pdfU   = (float)W * cSlope;                    // conditional density (over [0,1])

        float pdfUV  = pdfU * pdfV;                          // density over the unit uv square

        // --- Step 3: UV → spherical angles ---
        float phi      = (u - 0.5f) * 2.0f * PI;
        float theta    = (1.0f - v) * PI;
        float sinTheta = sin(theta);
        float3 dir = float3(sinTheta * sin(phi), cos(theta), sinTheta * cos(phi));

        // --- Step 4: Convert uv density → solid-angle density: dΩ = 2π²·sinθ · du·dv (pdf on the solid-angle density) ---
        float pOmega = pdfUV / (2.0f * PI * PI * max(sinTheta, 1e-4f));
        if (pOmega <= 1e-12f) continue;

        float inv_pOmega = 1.0f / pOmega;  // Monte Carlo weight = 1 / pdf

        // --- Step 5: parallax correction for probe position ---
        // Q is the point on the env sphere in direction `dir`.
        // dirProbe is the true direction from probe P to Q — used for SH basis evaluation.
        // For P=(0,0,0): dirProbe == dir, distSq == R², dOmegaProbe == dOmega exactly.
        float3 Q        = R * dir;
        float3 V        = Q - _ProbePosition;
        float  distSq   = max(dot(V, V), 1e-6f * R * R);
        float  dist     = sqrt(distSq);
        float3 dirProbe = V /dist;  // normalize(Q - P)

        // Solid angle of this patch as seen from probe P:
        //   dΩ_probe = R² · sin(θ)dθdφ · dot(D_outward_normal, dirProbe) / dist²
        //   dot(dir, dirProbe) > 0 always for probes strictly inside the sphere
        float  cosAngle = dot(dir, dirProbe);
        float  geom     = R * R * cosAngle / distSq;         // dΩ_probe / dΩ

        // --- Step 6: Accumulate the weighted SH projection for this sample f(ωₛ)/p(ωₛ) ---
        float  w        = geom * inv_pOmega;                                                                 // distribution weight (dOmegaProbe/pdf)
        float3 color    = _EquirectMap.SampleLevel(sampler_EquirectMap, float2(u, v), _MipLevel).rgb;  // environment color at this direction

        gSH[threadIndex][0] += color * SH_Y00()          * w;
        gSH[threadIndex][1] += color * SH_Y1n1(dirProbe) * w;
        gSH[threadIndex][2] += color * SH_Y10 (dirProbe) * w;
        gSH[threadIndex][3] += color * SH_Y1p1(dirProbe) * w;
        gSH[threadIndex][4] += color * SH_Y2n2(dirProbe) * w;
        gSH[threadIndex][5] += color * SH_Y2n1(dirProbe) * w;
        gSH[threadIndex][6] += color * SH_Y20 (dirProbe) * w;
        gSH[threadIndex][7] += color * SH_Y2p1(dirProbe) * w;
        gSH[threadIndex][8] += color * SH_Y2p2(dirProbe) * w;
        gWeight[threadIndex] += w;
    }

    // --- Step 7: Halving reduction: merge 64 partial sums into slot [0] ---                                                                        
    // Each step halves the active set; barrier ensures prior writes are visible.
    GroupMemoryBarrierWithGroupSync();
    [unroll] for (uint stride = NUM_THREADS / 2; stride > 0; stride >>= 1)
    {
        if (threadIndex < stride)
        {
            [unroll] for (int c = 0; c < 9; c++) gSH[threadIndex][c] += gSH[threadIndex + stride][c];
            gWeight[threadIndex] += gWeight[threadIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // --- Step 8: Self-normalizing (ratio) estimator: ∫dΩ_probe = 4π for any interior probe,
    // so dividing by the estimated weight sum removes the 1/N factor and any
    // pdf-normalization drift in one step. Thread 0 normalizes gSH[0] and writes
    // the buffer; a barrier then publishes the normalized coefficients to the group. ---   
    if (threadIndex == 0)
    {
        float normFactor = (gWeight[0] > 1e-12f) ? (4.0f * PI) / gWeight[0] : 0.0f;
        [unroll] for (int j = 0; j < 9; j++) gSH[0][j] *= normFactor;

        // --- Step 9: write coefficients to output buffer ---
        int outBase = _ProbeIndex * 9;
        [unroll] for (int i = 0; i < 9; i++) _SHCoeffs[outBase + i] = gSH[0][i];
    }
    GroupMemoryBarrierWithGroupSync();


    // --- Step 10: Debug ---
    // Debug pass: write the SH coefficients just computed for the ambient probe into _DiffuseMap.
    // For each output texel, reconstruct the diffuse color by evaluating the SH basis
    // at the texel's direction. The work is distributed across all threads, but only
    // only probe _DebugProbeIndex writes. This pass is skipped when _OutWidth/_OutHeight are 0.
    // Compiled in only when DEBUG_DIFFUSE_MAP is enabled.
#ifdef DEBUG_DIFFUSE_MAP
    if (_ProbeIndex == _DebugProbeIndex)
    {
        int total = _OutWidth * _OutHeight;
        for (int p = (int)threadIndex; p < total; p += NUM_THREADS)
        {
            int   px = p % _OutWidth;
            int   py = p / _OutWidth;
            float u  = (px + 0.5f) / (float)_OutWidth;
            float v  = (py + 0.5f) / (float)_OutHeight;
            float3 n = DirFromUV(u, v);

            float3 c = gSH[0][0] * SH_Y00()
                     + gSH[0][1] * SH_Y1n1(n)
                     + gSH[0][2] * SH_Y10 (n)
                     + gSH[0][3] * SH_Y1p1(n)
                     + gSH[0][4] * SH_Y2n2(n)
                     + gSH[0][5] * SH_Y2n1(n)
                     + gSH[0][6] * SH_Y20 (n)
                     + gSH[0][7] * SH_Y2p1(n)
                     + gSH[0][8] * SH_Y2p2(n);

            _DiffuseMap[uint2(px, py)] = float4(c, 1.0f);
        }
    }
#endif // DEBUG_DIFFUSE_MAP
}
