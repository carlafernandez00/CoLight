// EnvironmentToSH.compute
// Projects an equirectangular environment map (Skybox/Panoramic) to L2 Spherical Harmonics.
// Outputs 9 coefficients × RGB (27 floats) per probe into _SHCoeffs, with parallax correction
// based on the probe's world-space position relative to a virtual environment sphere of radius R.
//
// For a probe at position P, each env map pixel at direction D corresponds to a point Q = R·D
// on the sphere. The SH basis is evaluated at dirProbe = normalize(Q − P) and the solid angle
// is corrected for the probe's actual distance to Q:
//   dΩ_probe = sin(θ)dθdφ · R² · dot(D, dirProbe) / |Q − P|²
// For P = (0,0,0) this reduces exactly to the original dΩ = sin(θ)dθdφ.

#pragma kernel ProjectEquirectToSH

// --- Inputs ---
Texture2D<float4>   _EquirectMap;           // Equirectangular environment map (Skybox/Panoramic texture)
SamplerState        sampler_EquirectMap;    // Sampler for _EquirectMap
int                 _TexWidth;              // Width  of _EquirectMap at mip 0
int                 _TexHeight;             // Height of _EquirectMap at mip 0
int                 _MipLevel;              // Mip level to sample (0 = full res, 1 = half, 2 = quarter, ...)
float3              _ProbePosition;         // World-space position of the probe being projected
float               _EnvSphereRadius;       // Radius of the virtual environment sphere (scene scale)
int                 _ProbeIndex;            // Probe slot: coefficients written at [_ProbeIndex*9 + i]

// --- Output ---
// 9 SH coefficients per probe, one float3 (RGB) per coefficient.
// Buffer must have at least (_ProbeIndex + 1) * 9 elements.
RWStructuredBuffer<float3> _SHCoeffs;

// ---------------------------------------------------------------------------
// L2 Spherical Harmonics basis functions Y_i(dir)
// These are the real, normalized SH basis functions up to band 2.
// The constants (0.282095, 0.488603, etc.) are the normalization factors
// derived from the associated Legendre polynomials.
//
// Band 0 (1 function):  constant term
// Band 1 (3 functions): linear terms in x, y, z
// Band 2 (5 functions): quadratic terms
//
// dir = (x, y, z) unit direction vector, Y-up (Unity convention)
// ---------------------------------------------------------------------------

// Band 0
float SH_Y00()           { return 0.282095f; }                                      // 1/(2√π)

// Band 1
float SH_Y1n1(float3 d)  { return 0.488603f * d.y; }                               // √(3/4π) · y
float SH_Y10 (float3 d)  { return 0.488603f * d.z; }                               // √(3/4π) · z
float SH_Y1p1(float3 d)  { return 0.488603f * d.x; }                               // √(3/4π) · x

// Band 2
float SH_Y2n2(float3 d)  { return 1.092548f * d.x * d.y; }                         // √(15/4π) · xy
float SH_Y2n1(float3 d)  { return 1.092548f * d.y * d.z; }                         // √(15/4π) · yz
float SH_Y20 (float3 d)  { return 0.315392f * (3.0f * d.z * d.z - 1.0f); }         // √(5/16π) · (3z²-1)
float SH_Y2p1(float3 d)  { return 1.092548f * d.x * d.z; }                         // √(15/4π) · xz
float SH_Y2p2(float3 d)  { return 0.546274f * (d.x * d.x - d.y * d.y); }          // √(15/16π) · (x²-y²)

#define PI 3.14159265f
#define NUM_THREADS 64

// ---------------------------------------------------------------------------
// Groupshared memory: each thread accumulates into its own slot (no atomics).
// - Threads accumulate independently — no conflict, no atomics
// - Then a halving reduction folds 64 slots into slot [0]
// ---------------------------------------------------------------------------

groupshared float3 gSH[NUM_THREADS][9];   // partial SH per thread 
groupshared float  gWeight[NUM_THREADS];  // partial solid-angle weight per thread 

[numthreads(NUM_THREADS, 1, 1)]
void ProjectEquirectToSH(uint3 groupID : SV_GroupID, uint threadIndex : SV_GroupThreadID)
{
    // Init this thread's groupshared slots with the 9 SH coefficients (RGB each)
    [unroll] for (int k = 0; k < 9; k++) gSH[threadIndex][k] = float3(0, 0, 0);

    // Total solid angle weight for normalization
    gWeight[threadIndex] = 0.0f;
    float R = _EnvSphereRadius;

    // Mip-level loop bounds: each mip halves the resolution (>> is a bitwise right shift)
    int mipW = max(1, _TexWidth  >> _MipLevel);
    int mipH = max(1, _TexHeight >> _MipLevel);

    // Each thread processes a strided subset (stride = NUM_THREADS) of pixels in the mip level
    for (int y = (int)threadIndex; y < mipH; y += NUM_THREADS)
    {
        for (int x = 0; x < mipW; x++)
        {
            // --- Step 1: pixel index → UV in [0,1] ---
            // +0.5 samples the pixel CENTER, not its corner
            float u = (x + 0.5f) / (float)mipW;
            float v = (y + 0.5f) / (float)mipH;

            // --- Step 2: UV → spherical angles ---
            // Equirectangular mapping:
            //   u ∈ [0,1]  →  phi   (azimuth)  ∈ [0, 2π]
            //   v ∈ [0,1]  →  theta (polar)    ∈ [0, π]   (0 = north pole)
            float phi   = (u - 0.5f) * 2.0f * PI;  // u=0.5 → phi=0 → +Z, matches Unity's Panoramic skybox convention
            float theta = (1.0f - v) * PI;         // v=0 → theta=π (south pole), v=1 → theta=0 (north pole)

            // --- Step 3: spherical angles → Cartesian unit direction ---
            // Standard spherical → Cartesian, Y-up (Unity convention)
            float sinTheta = sin(theta);
            float3 dir = float3(
                sinTheta * sin(phi),    // x
                cos(theta),             // y (up)
                sinTheta * cos(phi)     // z
            );

            // --- Step 4: base differential solid angle (equirectangular correction) ---
            // Base solid angle: dΩ = sin(θ) · dθ · dφ
            // sin(θ) corrects for equirectangular distortion:
            //   poles   (θ→0 or π): sin(θ)→0, low weight
            //   equator (θ = π/2):  sin(θ)=1, full weight
            float dOmega = sinTheta * (PI / mipH) * (2.0f * PI / mipW);

            // --- Step 5: parallax correction for probe position ---
            // Q is the point on the env sphere in direction `dir`.
            // dirProbe is the true direction from probe P to Q — used for SH basis evaluation.
            // For P=(0,0,0): dirProbe == dir, distSq == R², dOmegaProbe == dOmega exactly.
            float3 Q        = R * dir;
            float3 V        = Q - _ProbePosition;
            float  distSq   = max(dot(V, V), 1e-6f * R * R); // guard against division by zero
            float  dist     = sqrt(distSq);
            float3 dirProbe = V / dist;                      // normalize(Q - P)

            // Solid angle of this patch as seen from probe P:
            //   dΩ_probe = R² · sin(θ)dθdφ · dot(D_outward_normal, dirProbe) / dist²
            // dot(dir, dirProbe) > 0 always for probes strictly inside the sphere.
            float cosAngle    = dot(dir, dirProbe);
            float dOmegaProbe = dOmega * R * R * cosAngle / distSq;

            // --- Step 6: sample environment color at this direction ---
            float3 color = _EquirectMap.SampleLevel(sampler_EquirectMap, float2(u, v), _MipLevel).rgb;

            // --- Step 7: accumulate SH projection ---
            // Use dirProbe (probe-relative direction) for basis functions,
            // dOmegaProbe (parallax-corrected solid angle) as weight.
            gSH[threadIndex][0] += color * SH_Y00()           * dOmegaProbe;
            gSH[threadIndex][1] += color * SH_Y1n1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][2] += color * SH_Y10 (dirProbe)  * dOmegaProbe;
            gSH[threadIndex][3] += color * SH_Y1p1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][4] += color * SH_Y2n2(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][5] += color * SH_Y2n1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][6] += color * SH_Y20 (dirProbe)  * dOmegaProbe;
            gSH[threadIndex][7] += color * SH_Y2p1(dirProbe)  * dOmegaProbe;
            gSH[threadIndex][8] += color * SH_Y2p2(dirProbe)  * dOmegaProbe;

            gWeight[threadIndex] += dOmegaProbe;
        }
    }

    // --- Step 8: Halving reduction: merge 64 partial sums into slot [0] ---                                                                        
    // Each step halves the active set; barrier ensures prior writes are visible. 
    GroupMemoryBarrierWithGroupSync();

    [unroll] for (uint stride = NUM_THREADS / 2; stride > 0; stride >>= 1) 
    {
        if (threadIndex < stride)
        {
            [unroll] for (int c = 0; c < 9; c++) gSH[threadIndex][c] += gSH[threadIndex + stride][c];
            gWeight[threadIndex] += gWeight[threadIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // Only thread 0 holds the final accumulated result — all others exit
    if (threadIndex != 0) return;

    // --- Step 9: normalize to 4π (total solid angle of a sphere) ---
    // Corrects for numerical drift in the discrete sum.
    float normFactor = (4.0f * PI) / gWeight[0];
    [unroll] for (int j = 0; j < 9; j++)
        gSH[0][j] *= normFactor;

    // --- Step 10: Lambertian (ZH) convolution — radiance → irradiance SH ---
    // Ramamoorthi & Hanrahan 2001 factors, required because Unity's SampleSH9
    // performs a plain polynomial eval with no runtime convolution.
    // gSH[0][0] *= PI;
    // gSH[0][1] *= (2.0f * PI / 3.0f);
    // gSH[0][2] *= (2.0f * PI / 3.0f);
    // gSH[0][3] *= (2.0f * PI / 3.0f);
    // gSH[0][4] *= (PI / 4.0f);
    // gSH[0][5] *= (PI / 4.0f);
    // gSH[0][6] *= (PI / 4.0f);
    // gSH[0][7] *= (PI / 4.0f);
    // gSH[0][8] *= (PI / 4.0f);

    // --- Step 11: write coefficients to output buffer ---
    int base = _ProbeIndex * 9;
    [unroll] for (int i = 0; i < 9; i++) _SHCoeffs[base + i] = gSH[0][i];
}
